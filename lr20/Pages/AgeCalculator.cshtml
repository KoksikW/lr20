@page
@model lr20.Pages.AgeCalculatorModel
@{
    ViewData["Title"] = "Калькулятор віку";
}

<h2>Дізнайся свій вік</h2>

<form method="post" class="mt-4">
    <div class="mb-3">
        <label>Введіть ваше ім'я:</label>
        <input type="text" name="UserName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Рік народження:</label>
        <input type="number" name="BirthYear" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Обчислити</button>
</form>

<hr />

@if (!string.IsNullOrEmpty(Model.ResultMessage))
{
    <div class="alert alert-success">
        @Model.ResultMessage
    </div>
}
